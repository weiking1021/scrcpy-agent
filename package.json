{
  "name": "scrcpy-agent",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:locales": "node scripts/check-locales.mjs",
    "gen:addon-types": "cd src-tauri && cargo test --lib export_bindings",
    "check:addon-types": "tsc -p addon-api/tsconfig.json",
    "pack:addon-types": "npm pack ./addon-api --pack-destination out",
    "addon-types": "npm run gen:addon-types && npm run check:addon-types && npm run pack:addon-types",
    "package": "node scripts/package.mjs",
    "build": "tsc && node scripts/check-locales.mjs && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
		"vite": "^8.0.16",
    "typescript": "~6.0.3"
  }
}
